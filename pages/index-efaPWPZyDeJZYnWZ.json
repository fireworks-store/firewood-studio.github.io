                "custom-code-plugin__code": "\n<div id=\"fw-test-menu\">\n  <button id=\"fw-test-button\">☰</button>\n\n  <div id=\"fw-test-panel\">\n    <button id=\"fw-test-close\">×</button>\n    <h2>FireWood Studio</h2>\n    <a href=\"#home\">Home</a>\n    <a href=\"#games\">Games</a>\n    <a href=\"#projects\">Projects</a>\n    <a href=\"#about\">About Us</a>\n    <a href=\"#contact\">Contact</a>\n  </div>\n</div>\n\n<style>\n#fw-test-button {\n  position: fixed;\n  top: 20px;\n  right: 20px;\n  z-index: 999999;\n  background: #203c2b;\n  color: white;\n  border: 1px solid #75947c;\n  border-radius: 12px;\n  padding: 12px 17px;\n  font-size: 25px;\n  cursor: pointer;\n}\n\n#fw-test-panel {\n  position: fixed;\n  top: 0;\n  right: 0;\n  width: 280px;\n  height: 100vh;\n  box-sizing: border-box;\n  padding: 30px;\n  background: rgba(20, 40, 28, 0.96);\n  color: white;\n  z-index: 1000000;\n  transform: translateX(110%);\n  transition: transform .35s ease;\n}\n\n#fw-test-panel.open {\n  transform: translateX(0);\n}\n\n#fw-test-panel a {\n  display: block;\n  color: white;\n  text-decoration: none;\n  padding: 15px;\n  margin-top: 10px;\n  background: rgba(255,255,255,.1);\n  border-radius: 10px;\n}\n\n#fw-test-close {\n  float: right;\n  background: none;\n  border: none;\n  color: white;\n  font-size: 30px;\n  cursor: pointer;\n}\n</style>\n\n<script>\nconst fwButton = document.getElementById(\"fw-test-button\");\nconst fwPanel = document.getElementById(\"fw-test-panel\");\nconst fwClose = document.getElementById(\"fw-test-close\");\n\nfwButton.addEventListener(\"click\", () => {\n  fwPanel.classList.add(\"open\");\n});\n\nfwClose.addEventListener(\"click\", () => {\n  fwPanel.classList.remove(\"open\");\n});\n\nfwPanel.querySelectorAll(\"a\").forEach(link => {\n  link.addEventListener(\"click\", () => {\n    fwPanel.classList.remove(\"open\");\n  });\n});\n</script>\n",
                "droppable": false,
                "type": "custom-code"
              }
