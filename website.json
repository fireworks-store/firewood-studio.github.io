  "settings": {
    "head": "\n<style>\n\n\n.firewood-glass {\n    background: linear-gradient(\n        135deg,\n        rgba(220, 255, 230, 0.18),\n        rgba(100, 160, 120, 0.07)\n    );\n\n    border: 1px solid rgba(230, 255, 235, 0.35);\n    border-radius: 20px;\n\n    backdrop-filter: blur(25px) saturate(180%);\n    -webkit-backdrop-filter: blur(25px) saturate(180%);\n\n    box-shadow:\n        0 8px 35px rgba(0, 0, 0, 0.3),\n        inset 0 1px 2px rgba(255, 255, 255, 0.35);\n\n    padding: 10px;\n    color: white;\n}\n \n  \n.projects-container {\n    width: 90%;\n    max-width: 1100px;\n    margin-left: auto;\n  \tmargin-right: auto;\n \tmargin-bottom: 49px;\n    padding-left: 49px;\n    padding-right: 49px;\n}\n/* Global animation */\n@keyframes fadeInUp {\n    from {\n        opacity: 0;\n        transform: translateY(20px);\n    }\n\n    to {\n        opacity: 1;\n        transform: translateY(0);\n    }\n}\n\n/* Animate website elements, excluding the menu */\nbody *:not(.fw-menu):not(.fw-menu *) {\n    animation: fadeInUp 0.7s ease-out backwards;\n}\n\n/* Hamburger animation is controlled separately */\n.fw-menu,\n.fw-menu * {\n    animation: none;\n}</style>\n"
